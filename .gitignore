# Dependencies
web/node_modules/
web/.next/
web/.env.local
node_modules/

# Secrets — root .env carries ANTHROPIC_API_KEY etc. Never commit.
.env
.env.local
.env.*.local

# Cost + audit logs (generated per-machine)
logs/api-cost.log

# Runtime file locks (lib/agent-runtime/locks.mjs) — per-process, never shared
.locks/

# Pristine pre-redaction originals kept by scripts/scrub-raw-pii.mjs.
# Lives outside raw/ on purpose: anything under raw/ gets indexed by the
# compiler and the night-shift walkers, which would turn each preserved
# original into a duplicate source. Contents carry contact PII by definition
# and must never be committed.
.pii-quarantine/

# Graphify temp files
.graphify_*

# macOS
.DS_Store
**/.DS_Store

# Build outputs
web/tsconfig.tsbuildinfo
graphify-out/cache/

# Claude Code session artifacts (generated per-machine)
.claude/*
# …but keep project-level skills versioned (SKILL.md definitions live here)
!.claude/skills/
!.claude/skills/**
# …and project-level slash commands (Foundry: /foundry-ingest, /foundry-compile, /foundry-ask, /foundry-lint)
!.claude/commands/
!.claude/commands/**

# Personal context graph — real seed contains PII (therapy themes, relationships).
# Only seed.example.json (placeholders) is committable.
wiki/personal/context-graph/seed.json
wiki/personal/context-graph/seed.*.local.json

# PIN-protected private layer — plaintext stays local; .enc blobs may commit
wiki/_private/*
!wiki/_private/.enc/
!wiki/_private/.enc/**
# Known noisy web server logs (exact files only; do not ignore all logs)
logs/web-server-error.log
logs/web-server.log
logs/audit.log
logs/kb-dev-server.log
# Daily lint cursor + open-findings ledger (per-machine generated state)
logs/lint-state.json
logs/lint-alerts.log
.env.bak*

# notes-to-factory per-run machine state — regenerated each run, can echo note content
# through the PII deny-list. Ledger stays tracked; last-run.json does not.
state/notes-to-factory/last-run.json
autolink-report.md
